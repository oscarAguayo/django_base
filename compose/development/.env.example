# APP
APP_NAME="example"
APP_VERSION="1.0.0"
APP_ENV="development" # local | development | production | etc.

# DOCKER
DOCKER_USERNAME="example"
DOCKER_APP_NAME="${APP_NAME}-${APP_ENV}"

# PYTHON
PYTHONPATH="src" # For autocomplete use `python -m venv venv_<APP_ENV>`

#DJANGO
DJANGO_SETTINGS_MODULE="config.settings.development"
DJANGO_SECRET_KEY="secret"
DJANGO_PORT=8000
DJANGO_DEBUG=True
# For first creation, set in blank if don't want to use
DJANGO_SUPERUSER_EMAIL=""
DJANGO_SUPERUSER_PASSWORD=""


# POSTGRES
POSTGRES_DB="${APP_NAME}_${APP_ENV}"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="postgres" # service name for db in docker-compose.yml
POSTGRES_PORT=5432